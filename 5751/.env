BIN_DIR="${SCRIPT_DIR}/../bin"
CLUSTER_NAME_ADMIN="admin"
CLUSTER_NAME_PRODUCTION="production"
CLUSTER_NAME_OPENBAO="openbao"
CLUSTER_NAME_VSO="vso"

CLUSTER_CONTEXT_OPENBAO="kind-local-cluster-${CLUSTER_NAME_OPENBAO}"
HELM_OPENBAO="helm --kube-context ${CLUSTER_CONTEXT_OPENBAO}"
KUBECTL_OPENBAO="kubectl --context ${CLUSTER_CONTEXT_OPENBAO}"

CLUSTER_CONTEXT_VSO="kind-local-cluster-${CLUSTER_NAME_VSO}"
HELM_VSO="helm --kube-context ${CLUSTER_CONTEXT_VSO}"
KUBECTL_VSO="kubectl --context ${CLUSTER_CONTEXT_VSO}"

CLUSTER_CONTEXT_ADMIN="kind-local-cluster-${CLUSTER_NAME_ADMIN}"
HELM_ADMIN="helm --kube-context ${CLUSTER_CONTEXT_ADMIN}"
KUBECTL_ADMIN="kubectl --context ${CLUSTER_CONTEXT_ADMIN}"

CLUSTER_CONTEXT_PRODUCTION="kind-local-cluster-${CLUSTER_NAME_PRODUCTION}"
HELM_PRODUCTION="helm --kube-context ${CLUSTER_CONTEXT_PRODUCTION}"
KUBECTL_PRODUCTION="kubectl --context ${CLUSTER_CONTEXT_PRODUCTION}"

NS_OPENBAO="openbao"
NS_VSO="vso"
NS_APP="app"

ADMIN_INGRESS_IP="172.18.255.0"
ADMIN_INGRESS_HOSTNAME="openbao.local"

VSO_INGRESS_IP="172.18.255.1"
VSO_INGRESS_HOSTNAME="vso-cluster-example.com"
VSO_INGRESS_PORT="443"

POD_TEMP_PATH="/home/openbao"
POD_VAULT_CMD="bao"

CA_CERT_DIR=/tmp/ca-cert-dir
CA_CERT_FILEKEY=$CA_CERT_DIR/shared-ca.key
CA_CERT_FILECRT=$CA_CERT_DIR/shared-ca.crt

STATIC_SECRET_NAME="demo-static-secret"
OPENBAO_SECRET_PATH="demo-app/config"
K8S_SECRET_NAME="demo-secret"
STATIC_SECRET_FILENAME="${STATIC_SECRET_NAME}.yaml"

# Unauthorized in the sense of the openbao policy, nothing allows its access from the
# vso standpoint
UNAUTHORIZED_MOUNT=unauthorized
UNAUTHORIZED_STATIC_SECRET_NAME="demo-static-unauthorized-secret"
UNAUTHORIZED_STATIC_SECRET_FILENAME="${UNAUTHORIZED_STATIC_SECRET_NAME}.yaml"
UNAUTHORIZED_K8S_SECRET_NAME="unauthorized-demo-secret"
