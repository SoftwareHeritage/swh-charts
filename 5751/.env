CLUSTER_NAME_OPENBAO="openbao"
CLUSTER_NAME_VSO="vso"

CLUSTER_CONTEXT_OPENBAO="kind-local-cluster-${CLUSTER_NAME_OPENBAO}"
HELM_OPENBAO="helm --kube-context ${CLUSTER_CONTEXT_OPENBAO}"
KUBECTL_OPENBAO="kubectl --context ${CLUSTER_CONTEXT_OPENBAO}"

CLUSTER_CONTEXT_VSO="kind-local-cluster-${CLUSTER_NAME_VSO}"
HELM_VSO="helm --kube-context ${CLUSTER_CONTEXT_VSO}"
KUBECTL_VSO="kubectl --context ${CLUSTER_CONTEXT_VSO}"

NS_OPENBAO="openbao"
NS_VSO="vso"
NS_APP="app"

OPENBAO_INGRESS_IP="172.18.255.0"
OPENBAO_INGRESS_HOSTNAME="openbao.local"

VSO_INGRESS_IP="172.18.255.1"
VSO_INGRESS_HOSTNAME="vso-cluster-example.com"
VSO_INGRESS_PORT="443"

POD_TEMP_PATH="/home/openbao"
POD_VAULT_CMD="bao"

SERVICE_ACCOUNT_NAME="default"
ROLE="role-${CLUSTER_NAME_VSO}"
MOUNT="mount-${CLUSTER_NAME_VSO}"

CA_CERT_DIR=/tmp/ca-cert-dir
CA_CERT_FILEKEY=$CA_CERT_DIR/shared-ca.key
CA_CERT_FILECRT=$CA_CERT_DIR/shared-ca.crt
