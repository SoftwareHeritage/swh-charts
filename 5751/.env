BIN_DIR="${SCRIPT_DIR}/../bin"
CLUSTER_NAME_ADMIN="admin"
CLUSTER_NAME_PRODUCTION="production"
CLUSTER_NAME_OPENBAO="openbao"
CLUSTER_NAME_VSO="vso"

NS_OPENBAO="openbao"
NS_VSO="vso"
NS_APP="app"

CLUSTER_CONTEXT_OPENBAO="local-cluster-${CLUSTER_NAME_OPENBAO}"
KUBECONFIG_PATH_OPENBAO="$HOME/.kube/config.d/${CLUSTER_CONTEXT_OPENBAO}.yaml"
HELM_OPENBAO="helm --kubeconfig ${KUBECONFIG_PATH_OPENBAO}"
KUBECTL_OPENBAO="kubectl --kubeconfig ${KUBECONFIG_PATH_OPENBAO}"

CLUSTER_CONTEXT_VSO="local-cluster-${CLUSTER_NAME_VSO}"
KUBECONFIG_PATH_VSO="$HOME/.kube/config.d/${CLUSTER_CONTEXT_VSO}.yaml"
HELM_VSO="helm --kubeconfig ${KUBECONFIG_PATH_VSO}"
KUBECTL_VSO="kubectl --kubeconfig ${KUBECONFIG_PATH_VSO}"

CLUSTER_CONTEXT_ADMIN="local-cluster-${CLUSTER_NAME_ADMIN}"
KUBECONFIG_PATH_ADMIN="$HOME/.kube/config.d/${CLUSTER_CONTEXT_ADMIN}.yaml"
HELM_ADMIN="helm --kubeconfig ${KUBECONFIG_PATH_ADMIN}"
KUBECTL_ADMIN="kubectl --kubeconfig ${KUBECONFIG_PATH_ADMIN}"

CLUSTER_CONTEXT_PRODUCTION="local-cluster-${CLUSTER_NAME_PRODUCTION}"
KUBECONFIG_PATH_PRODUCTION="$HOME/.kube/config.d/${CLUSTER_CONTEXT_PRODUCTION}.yaml"
HELM_PRODUCTION="helm --kubeconfig ${KUBECONFIG_PATH_PRODUCTION}"
KUBECTL_PRODUCTION="kubectl --kubeconfig ${KUBECONFIG_PATH_PRODUCTION}"

ADMIN_INGRESS_IP="172.18.255.0"
ADMIN_INGRESS_HOSTNAME="openbao.local"

POD_TEMP_PATH="/home/openbao"
POD_VAULT_CMD="bao"

CA_CERT_DIR=/tmp/ca-cert-dir
CA_CERT_FILEKEY=$CA_CERT_DIR/shared-ca.key
CA_CERT_FILECRT=$CA_CERT_DIR/shared-ca.crt

STATIC_SECRET_NAME="demo-static-secret"
OPENBAO_SECRET_PATH="demo-app/config"
K8S_SECRET_NAME="demo-secret"
STATIC_SECRET_FILENAME="${STATIC_SECRET_NAME}.yaml"

# Unauthorized in the sense of the openbao policy, nothing allows its access from the
# vso standpoint
UNAUTHORIZED_MOUNT=unauthorized
UNAUTHORIZED_STATIC_SECRET_NAME="demo-static-unauthorized-secret"
UNAUTHORIZED_STATIC_SECRET_FILENAME="${UNAUTHORIZED_STATIC_SECRET_NAME}.yaml"
UNAUTHORIZED_K8S_SECRET_NAME="unauthorized-demo-secret"
